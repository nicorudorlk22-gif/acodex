# ==============================================================
# AcodeX — Configuração privada (copie para .env e preencha)
# O arquivo .env é ignorado pelo git — nunca é commitado.
# ==============================================================

# Chave da API de IA (Acodex AI)
AI_API_KEY=

# Endpoint base do provedor (ex.: https://openrouter.ai/api/v1)
AI_BASE_URL=

# Modelo padrão (ex.: google/gemini-2.0-flash-exp:free)
AI_MODEL=

# Token do GitHub (para scripts locais de deploy/CI)
GITHUB_TOKEN=

# NVIDIA NIM — free tier (https://integrate.api.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
